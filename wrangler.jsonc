{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-data",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "vars": {
    "APP_ORIGIN": "https://web-app-data.data-analist.workers.dev",
    "ENFORCE_CANONICAL_ORIGIN": "false",
    "DATA_SHAPER_BILLING_ENABLED": "false",
    "LEGAL_DISCLOSURE_URL": "https://namidata-lab-public.lingering-salad-74bc.workers.dev/legal/disclosure-request"
  },
  "secrets": {
    "required": [
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  }
}

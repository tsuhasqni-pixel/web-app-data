{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-data",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "vars": {
    "APP_ORIGIN": "https://web-app-data.data-analist.workers.dev",
    "ENFORCE_CANONICAL_ORIGIN": "false",
    "DATA_SHAPER_BILLING_ENABLED": "true",
    "LEGAL_DISCLOSURE_URL": "https://namidata-lab-public.lingering-salad-74bc.workers.dev/legal/disclosure-request",
    "DATA_SHAPER_STRIPE_TEST_PRICE_ID": "price_1UaHXEBGa8rL8jwIIhFKKasw",
    "DATA_SHAPER_TAX_DISPLAY_CONFIRMED": "true",
    "DATA_SHAPER_LIVE_BILLING_ENABLED": "true",
    "DATA_SHAPER_REFUND_POLICY_CONFIRMED": "true",
    "DATA_SHAPER_LIVE_SALE_APPROVED": "true",
    "DATA_SHAPER_STRIPE_LIVE_LITE_PRICE_ID": "price_1Uav2zBGa8rL8jwIJtqLaBJC",
    "DATA_SHAPER_STRIPE_LIVE_PRO_PRICE_ID": "price_1Uav3IBGa8rL8jwIJcEFxAFI",
    "DATA_SHAPER_STRIPE_LIVE_PORTAL_CONFIG_ID": "bpc_1Uav4GBGa8rL8jwIqg24naP8"
  },
  "secrets": {
    "required": [
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "data-shaper-db",
      "database_id": "8b53d1e1-0e2f-4cde-81a3-9d8ab1eed908"
    }
  ]
}
